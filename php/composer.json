{
    "name": "hostfog/sigil",
    "description": "JWT, JWS, JWE and JWK for PHP",
    "type": "library",
    "license": "MIT",
    "keywords": ["jwt", "jws", "jwe", "jwk", "jose"],
    "authors": [
        {
            "name": "HostFog Ltd"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "HostFog\\Sigil\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HostFog\\Sigil\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
